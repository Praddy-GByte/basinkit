version: 0.1.0
date-released: 2026-08-30
license: MIT
repository-code: "https://github.com/Praddy-GByte/basinkit"
url: "https://github.com/Praddy-GByte/basinkit"
keywords:
  - hydrology
  - watershed delineation
  - river basin
  - remote sensing
  - earth observation
  - open data
  - gis
  - qgis
